#!/bin/bash
#PBS -N moe_cpu_256
#PBS -j oe
#PBS -l select=4:ncpus=64:mpiprocs=64:ompthreads=1:mem=250gb
#PBS -l place=scatter
#PBS -l walltime=01:00:00

set -eo pipefail
: "${PBS_O_WORKDIR:?PBS_O_WORKDIR is required}"
: "${PBS_JOBID:?PBS_JOBID is required}"
cd "$PBS_O_WORKDIR"

job_label=${PBS_JOBID%%.*}
output_dir="$PBS_O_WORKDIR/private/formal-cpu-$job_label"
mkdir -p "$output_dir"

export PAGER=cat LMOD_PAGER=cat
module load gompi/2024a
module load CMake/3.29.3-GCCcore-13.3.0
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
export OMP_NUM_THREADS=1 OMP_PLACES=cores OMP_PROC_BIND=close OMP_DYNAMIC=FALSE

if [[ -n $(git status --porcelain --untracked-files=no) ]]; then
  echo 'Tracked source files have uncommitted changes; refusing an unversioned run.' >&2
  exit 1
fi
if [[ ! -f "${PBS_NODEFILE:-}" ]]; then
  echo 'PBS_NODEFILE is missing.' >&2
  exit 1
fi
slots=$(wc -l < "$PBS_NODEFILE")
nodes=$(sort -u "$PBS_NODEFILE" | wc -l)
if (( slots < 256 || nodes != 4 )); then
  echo "Expected at least 256 MPI slots on exactly 4 nodes; got $slots slots on $nodes nodes." >&2
  exit 1
fi

{
  printf 'git_commit=%s\n' "$(git rev-parse HEAD)"
  printf 'pbs_jobid=%s\n' "$PBS_JOBID"
  printf 'pbs_select=%s\n' '4:ncpus=64:mpiprocs=64:ompthreads=1:mem=250gb'
  printf 'mpi_slots=%s\nnode_count=%s\n' "$slots" "$nodes"
  printf 'cpu_binding=%s\n' 'slot:PE=1,bind-to=core'
  printf 'warmups=3\nrepeats=5\n'
  printf 'strong_tokens=131072\nweak_tokens_per_rank=4096\n'
  printf 'compiler=%s\n' "$(command -v c++)"
  printf 'mpirun=%s\n' "$(command -v mpirun)"
  printf 'cmake=%s\n' "$(command -v cmake)"
} > "$output_dir/metadata.txt"
module list > "$output_dir/modules.txt" 2>&1
sort -u "$PBS_NODEFILE" > "$output_dir/nodes.txt"
cp "$PBS_NODEFILE" "$output_dir/pbs_nodefile.txt"

mpirun --map-by ppr:1:node -np "$nodes" sh -c \
  'model=$(lscpu | grep -m1 "^Model name:" | cut -d: -f2- | xargs); test -n "$model" || exit 1; printf "%s,%s\n" "$(hostname)" "$model"' \
  | sort > "$output_dir/node_models.csv"
model_count=$(cut -d, -f2- "$output_dir/node_models.csv" | sort -u | wc -l)
if (( model_count != 1 )); then
  echo 'Allocated nodes have different CPU models; stopping before timing.' >&2
  cat "$output_dir/node_models.csv" >&2
  exit 1
fi

cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DMOE_ENABLE_CUDA=OFF \
  > "$output_dir/configure.log" 2>&1
cmake --build build --target moe_launch_probe moe_cpu_bench -j 8 \
  > "$output_dir/build.log" 2>&1

mpirun --map-by ppr:1:node --bind-to core -np "$nodes" \
  ./build/moe_launch_probe --expect-threads 1 --require-distinct-hosts \
  > "$output_dir/four_node_probe.txt" 2>&1
mpirun --map-by slot:PE=1 --bind-to core -np 256 \
  ./build/moe_launch_probe --expect-threads 1 \
  > "$output_dir/256_rank_probe.txt" 2>&1

printf '%s\n' 'series,trial,parallelism,communication,tokens,experts,ranks,threads,end_to_end_seconds,dispatch_pack_seconds,dispatch_comm_seconds,expert_compute_seconds,return_pack_seconds,return_comm_seconds,validation_unpack_seconds,combine_seconds,bitwise_ok' \
  > "$output_dir/all_trials.csv"
printf '%s\n' 'series,ranks,tokens,median_end_to_end_seconds' \
  > "$output_dir/medians.csv"

run_point() {
  local kind=$1 ranks=$2 tokens=$3
  local log_file="$output_dir/${kind}-p${ranks}.txt"
  echo "Starting $kind: P=$ranks N=$tokens"
  mpirun --map-by slot:PE=1 --bind-to core -np "$ranks" \
    ./build/moe_cpu_bench --parallelism ep --communication alltoallv \
    --router-mode trace --skew uniform --tokens "$tokens" --experts 256 \
    > "$log_file" 2>&1
  grep -q '^benchmark_expert_histogram=' "$log_file"
  grep -q '^benchmark_rank_assignment_histogram=' "$log_file"
  awk '/^benchmark,trial=/{n++; if ($0 !~ /,bitwise_ok=1$/) bad=1}
       END {if (n != 5 || bad) exit 1}' "$log_file"
  awk -F, -v series="$kind" '/^benchmark,trial=/{
    printf "%s", series
    for (i=2; i<=NF; ++i) {
      split($i, item, "=")
      printf ",%s", item[2]
    }
    printf "\n"
  }' "$log_file" >> "$output_dir/all_trials.csv"
  median=$(awk -F, '/^benchmark,trial=/{
    for (i=2; i<=NF; ++i) if ($i ~ /^end_to_end_seconds=/) {
      split($i, item, "=")
      print item[2]
    }
  }' "$log_file" | sort -g | sed -n '3p')
  printf '%s,%s,%s,%s\n' "$kind" "$ranks" "$tokens" "$median" \
    >> "$output_dir/medians.csv"
  echo "PASS $kind: P=$ranks N=$tokens ($log_file)"
}

# Exercise the largest allocations first. If either fails, no smaller formal
# series is run. The successful points are retained as part of the same series.
run_point strong 256 131072
run_point weak 256 1048576
for ranks in 1 2 4 8 16 32 64 128; do
  run_point strong "$ranks" 131072
  run_point weak "$ranks" "$((4096 * ranks))"
done

echo "All 18 strong/weak points passed. Summaries and raw outputs: $output_dir"
